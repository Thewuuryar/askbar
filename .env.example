# Copy to .env and edit. Never commit .env.

# Host ports. The API is published on all interfaces; the admin site on 127.0.0.1 only.
ASKBAR_API_PORT=8080
ASKBAR_ADMIN_PORT=8081

# URL clients use to reach the API (goes into pairing strings). Default: http://localhost:$ASKBAR_API_PORT
# ASKBAR_PUBLIC_URL=https://askbar.example.com:8443

# Public hostname (used by the `tls` profile).
ASKBAR_HOST=askbar.example.com

# Where the database lives on the host. Must be writable by ASKBAR_UID:ASKBAR_GID.
DATA_DIR=./data
# Run the container as this user (default 10001). For a local bind mount you can use your own: `id -u`, `id -g`.
ASKBAR_UID=10001
ASKBAR_GID=10001

# Initial admin password (hashed on first start).
ASKBAR_ADMIN_PASSWORD=change-me

# Cloudflare API token for the `tls` profile (Zone:DNS:Edit, Zone:Zone:Read).
CF_API_TOKEN=
