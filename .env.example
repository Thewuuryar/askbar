# Copy to .env and edit. Never commit .env.
# Nothing secret belongs here: the admin password, master key and Cloudflare token
# are all created or entered in the admin site.
# Only Caddy publishes ports (443 and 80). The server and the admin publish none.

# URL clients use to reach the API (goes into pairing strings), e.g. https://askbar.example.com
# ASKBAR_PUBLIC_URL=

# Where the server's database lives on the host. Must be writable by uid 10002 (the server image's user;
# it was 10001 before 0.3.0). Hostname, certificate token and allowed networks are set in the admin site.
DATA_DIR=./data
