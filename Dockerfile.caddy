# Caddy with the Cloudflare DNS plugin, used to get certificates without opening port 80/443.
FROM caddy:2-builder AS build
RUN xcaddy build --with github.com/caddy-dns/cloudflare

FROM caddy:2
COPY --from=build /usr/bin/caddy /usr/bin/caddy
COPY caddy/bootstrap.Caddyfile /etc/caddy/bootstrap.Caddyfile
# The server pushes the real configuration through the admin API; `--resume` brings back
# the last one after a restart. The bootstrap file only opens the admin API for the compose network.
CMD ["caddy", "run", "--config", "/etc/caddy/bootstrap.Caddyfile", "--adapter", "caddyfile", "--resume"]
