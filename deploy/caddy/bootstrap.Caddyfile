# Starting point only. The admin replaces this with the real configuration (Network settings)
# through Caddy's admin socket. This copy is what the admin generates while HTTPS is off: Caddy's own
# admin socket, and the first-run site (the admin over plain HTTP on the setup address, for the host's
# loopback only). A test keeps the two the same.
{
	admin unix//run/caddy/admin.sock|0660
}

http://:8081 {
	bind 172.31.0.2
	@admin path /admin /admin/*
	handle @admin {
		reverse_proxy unix//run/admin/admin.sock
	}
	handle {
		header Content-Type application/problem+json
		respond `{"type":"urn:askbar:problem:not_found","title":"Not found","status":404,"detail":"There is nothing at this address.","error":"not_found"}` 404
	}
}
